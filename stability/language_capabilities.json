{
  "version": 2,
  "languages": ["go", "typescript", "swift", "rust"],
  "capability_layers": ["portable_core", "server_integration", "control_plane", "sdk_profile", "language_convenience"],
  "portable_capabilities": [
    {
      "id": "opaque_artifact",
      "layer": "portable_core",
      "description": "Strict Flowersec v2 artifact parsing behind an opaque application-facing value",
      "implementations": {
        "go": { "status": "complete", "test_ids": ["protocol/go"] },
        "typescript": { "status": "complete", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "complete", "test_ids": ["protocol/swift"] },
        "rust": { "status": "complete", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "opaque_connector",
      "layer": "portable_core",
      "description": "Lease-consuming direct and tunnel connection without exposing carrier credentials",
      "implementations": {
        "go": { "status": "complete", "test_ids": ["controller/go"] },
        "typescript": { "status": "complete", "test_ids": ["controller/typescript-real-network-restart"] },
        "swift": { "status": "complete", "test_ids": ["controller/swift-real-network-restart"] },
        "rust": { "status": "complete", "test_ids": ["controller/rust"] }
      }
    },
    {
      "id": "secure_session",
      "layer": "portable_core",
      "description": "Authenticated v2 sessions, bounded streams, rekey, cancellation, and close",
      "implementations": {
        "go": { "status": "complete", "test_ids": ["protocol/go"] },
        "typescript": { "status": "complete", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "complete", "test_ids": ["protocol/swift"] },
        "rust": { "status": "complete", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "rpc_call_notify",
      "layer": "portable_core",
      "description": "Outbound RPC calls and notifications over the reserved encrypted v2 stream kind",
      "implementations": {
        "go": { "status": "complete", "test_ids": ["protocol/go"] },
        "typescript": { "status": "complete", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "complete", "test_ids": ["protocol/swift"] },
        "rust": { "status": "complete", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "validated_stream_metadata",
      "layer": "portable_core",
      "description": "Construction-validated application stream metadata used by both outgoing and incoming streams",
      "implementations": {
        "go": { "status": "complete", "test_ids": ["carrier/go-direct"] },
        "typescript": { "status": "complete", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "complete", "test_ids": ["protocol/swift"] },
        "rust": { "status": "complete", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "connection_controller",
      "layer": "portable_core",
      "description": "Single-owner long-lived connection lifecycle with fresh artifacts, structured retry, cancellation, and session replacement",
      "implementations": {
        "go": { "status": "complete", "test_ids": ["controller/go"] },
        "typescript": { "status": "complete", "test_ids": ["controller/typescript"] },
        "swift": { "status": "complete", "test_ids": ["controller/swift"] },
        "rust": { "status": "complete", "test_ids": ["controller/rust"] }
      }
    },
    {
      "id": "server_acceptor_session",
      "layer": "server_integration",
      "description": "Carrier-neutral server admission establishes the same public Session contract without exposing carrier or wire state; each runtime profile declares its exact listener support.",
      "implementations": {
        "go": { "status": "complete", "entrypoint": "flowersec.NewAcceptor/Acceptor.Handler/AcceptorOptions.ResolveHandlers/SessionHandlers", "test_ids": ["server/go-acceptor"] },
        "typescript": { "status": "complete", "entrypoint": "@floegence/flowersec-core/node createAcceptor/Acceptor.accept -> AcceptedSession", "test_ids": ["server/typescript-acceptor"] },
        "swift": { "status": "unsupported", "entrypoint": "Flowersec", "reason": "Apple application processes do not provide the deployable listener profile required by this boundary.", "alternative_boundary": "Deploy flowersec-runtime and keep the Apple process on the Swift client Session boundary.", "test_ids": ["protocol/swift"] },
        "rust": { "status": "complete", "entrypoint": "flowersec::Acceptor::accept/accept_with_handlers -> Session/AcceptedSession", "test_ids": ["server/rust-acceptor"] }
      }
    },
    {
      "id": "server_session_handlers",
      "layer": "server_integration",
      "description": "Accepted sessions bind inbound RPC and application stream handlers before encrypted session establishment and keep one lifecycle owner.",
      "implementations": {
        "go": { "status": "complete", "entrypoint": "AcceptorOptions.ResolveHandlers/NewSessionHandlers/SessionHandlers.HandleRPC/SessionHandlers.HandleStream", "test_ids": ["server/go-acceptor"] },
        "typescript": { "status": "complete", "entrypoint": "createAcceptor/SessionHandlers.handleRPC/SessionHandlers.handleStream/AcceptedSession.serve", "test_ids": ["server/typescript-acceptor"] },
        "swift": { "status": "unsupported", "entrypoint": "Flowersec", "reason": "The Apple listener profile is unsupported, so it cannot own pre-establishment inbound handlers.", "alternative_boundary": "Register handlers in flowersec-runtime and use the Swift client Session for outbound RPC and streams.", "test_ids": ["protocol/swift"] },
        "rust": { "status": "complete", "entrypoint": "flowersec::Acceptor::accept_with_handlers/SessionHandlers/RpcHandler/StreamHandler/AcceptedSession::serve", "test_ids": ["server/rust-acceptor-handlers"] }
      }
    },
    {
      "id": "controlplane_issue_authorize",
      "layer": "control_plane",
      "description": "Opaque artifact issuance, durable authorization records, and runtime admission authorization.",
      "implementations": {
        "go": { "status": "complete", "entrypoint": "flowersec-go/v2/controlplane", "test_ids": ["server/go-controlplane"] },
        "typescript": { "status": "unsupported", "entrypoint": "@floegence/flowersec-core", "reason": "Control-plane persistence and atomic authorization require the service datastore boundary absent from the client SDK.", "alternative_boundary": "Call an application service built on flowersec-go/v2/controlplane and consume only its opaque artifact response.", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "unsupported", "entrypoint": "Flowersec", "reason": "Control-plane persistence and atomic authorization are outside the Apple client SDK profile.", "alternative_boundary": "Call an application service built on flowersec-go/v2/controlplane and consume its opaque artifact response.", "test_ids": ["protocol/swift"] },
        "rust": { "status": "unsupported", "entrypoint": "flowersec", "reason": "The native crate is a session runtime and does not own an application control-plane datastore.", "alternative_boundary": "Call flowersec-go/v2/controlplane through the application's authenticated service HTTP boundary.", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "server_admission_paths",
      "layer": "server_integration",
      "description": "Exact runtime-profile direct and tunnel admission paths with authorization binding and bounded cleanup; a complete status never implies carriers absent from the named entrypoint.",
      "implementations": {
        "go": { "status": "complete", "entrypoint": "flowersec.Acceptor.Handler: WSS direct+tunnel; flowersec-runtime: WSS/raw QUIC/WebTransport direct+tunnel", "test_ids": ["server/go-acceptor"] },
        "typescript": { "status": "complete", "entrypoint": "@floegence/flowersec-core/node createAcceptor: WebTransport direct", "test_ids": ["server/typescript-acceptor"] },
        "swift": { "status": "unsupported", "entrypoint": "Flowersec", "reason": "Apple platforms do not provide the deployable listener profile used by Flowersec servers.", "alternative_boundary": "Deploy flowersec-runtime and connect through the public Swift Session API.", "test_ids": ["protocol/swift"] },
        "rust": { "status": "complete", "entrypoint": "flowersec::Acceptor: raw QUIC direct", "test_ids": ["server/rust-acceptor"] }
      }
    },
    {
      "id": "browser_proxy_runtime",
      "layer": "server_integration",
      "description": "The TypeScript browser proxy runtime and Go server ProxyServer share one bounded Session/ByteStream application protocol for HTTP and WebSocket forwarding.",
      "implementations": {
        "go": { "status": "complete", "entrypoint": "flowersec.NewProxyServer/ProxyServer.Register(SessionHandlers)", "test_ids": ["server/go-proxy"] },
        "typescript": { "status": "complete", "entrypoint": "@floegence/flowersec-core/proxy createProxyRuntime", "test_ids": ["server/typescript-proxy"] },
        "swift": { "status": "unsupported", "entrypoint": "Flowersec", "reason": "The browser Service Worker and MessagePort APIs do not exist on the Apple SDK profile.", "alternative_boundary": "Use the public Swift Session stream API and deploy the Go ProxyServer for browser peers.", "test_ids": ["protocol/swift"] },
        "rust": { "status": "unsupported", "entrypoint": "flowersec", "reason": "The browser Service Worker proxy application is not part of the native Rust profile.", "alternative_boundary": "Deploy the Go ProxyServer and use public Rust Session streams for native applications.", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "loopback_plaintext_websocket_direct",
      "layer": "portable_core",
      "description": "Restricted plaintext WebSocket direct profile for local loopback development only; network-facing and tunnel plaintext candidates are rejected.",
      "implementations": {
        "go": { "status": "complete", "entrypoint": "flowersec-go/v2 artifact parser and WebSocket connector", "test_ids": ["protocol/go"] },
        "typescript": { "status": "complete", "entrypoint": "@floegence/flowersec-core artifact parser", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "complete", "entrypoint": "Flowersec artifact parser", "test_ids": ["protocol/swift"] },
        "rust": { "status": "complete", "entrypoint": "flowersec artifact parser", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "carrier_contract",
      "layer": "portable_core",
      "description": "Carrier-neutral stream semantics with WSS, raw QUIC, and WebTransport capability reporting",
      "implementations": {
        "go": { "status": "complete", "test_ids": ["carrier/go-direct"] },
        "typescript": { "status": "complete", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "complete", "test_ids": ["protocol/swift"] },
        "rust": { "status": "complete", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "wire_security",
      "layer": "portable_core",
      "description": "Canonical v2 handshake, record protection, admission binding, and Unicode validation",
      "implementations": {
        "go": { "status": "complete", "test_ids": ["protocol/go"] },
        "typescript": { "status": "complete", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "complete", "test_ids": ["protocol/swift"] },
        "rust": { "status": "complete", "test_ids": ["protocol/rust"] }
      }
    }
  ],
  "runtime_specific_capabilities": [
    {
      "id": "typescript_rpc_notification_subscription",
      "layer": "language_convenience",
      "owner": "typescript",
      "reason": "TypeScript exposes application notification subscriptions on its public RPC peer.",
      "test_ids": ["protocol/typescript"]
    },
    {
      "id": "go_rpc_request_handlers",
      "layer": "language_convenience",
      "owner": "go",
      "reason": "Go exposes application request handler registration through SessionHandlers.",
      "test_ids": ["protocol/go"]
    },
    {
      "id": "browser_webtransport",
      "layer": "sdk_profile",
      "owner": "typescript",
      "reason": "Browser WebTransport uses browser-owned networking APIs.",
      "test_ids": ["browser/chromium/webtransport/direct"]
    },
    {
      "id": "node_webtransport",
      "layer": "sdk_profile",
      "owner": "typescript",
      "reason": "Node.js owns native WebTransport client and server adapters over the pinned libquiche runtime.",
      "test_ids": ["integration/typescript/node-webtransport"]
    },
    {
      "id": "native_raw_quic",
      "layer": "sdk_profile",
      "owner": "go",
      "reason": "Go owns the deployable native raw QUIC listener used by cross-language validation.",
      "test_ids": ["interop/rust-go/raw-quic/direct"]
    },
    {
      "id": "rust_native_raw_quic",
      "layer": "sdk_profile",
      "owner": "rust",
      "reason": "Rust owns its native raw QUIC connector and runtime listener implementation.",
      "test_ids": ["interop/rust-go/raw-quic/direct"]
    },
    {
      "id": "swift_apple_websocket",
      "layer": "sdk_profile",
      "owner": "swift",
      "reason": "The Swift production connector supports WSS direct and tunnel dialing on macOS and iOS.",
      "test_ids": ["interop/swift-go/wss/direct"]
    },
    {
      "id": "go_negotiated_unreliable_messages",
      "layer": "sdk_profile",
      "owner": "go",
      "reason": "Go exposes negotiated carrier-neutral unreliable-message channels with accepted and dropped send outcome semantics.",
      "test_ids": ["carrier/go-direct"]
    },
    {
      "id": "typescript_negotiated_unreliable_messages",
      "layer": "sdk_profile",
      "owner": "typescript",
      "reason": "TypeScript exposes negotiated carrier-neutral unreliable-message channels with accepted and dropped send outcome semantics.",
      "test_ids": ["protocol/typescript"]
    },
    {
      "id": "rust_negotiated_unreliable_messages",
      "layer": "sdk_profile",
      "owner": "rust",
      "reason": "Rust exposes negotiated carrier-neutral unreliable-message channels with accepted and dropped send outcome semantics.",
      "test_ids": ["interop/rust-go/raw-quic/direct"]
    }
  ],
