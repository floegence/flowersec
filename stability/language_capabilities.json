  "portable_capabilities": [
    {
      "id": "opaque_artifact",
      "layer": "portable_core",
      "description": "Strict Flowersec v3 artifact and TLS-policy parsing behind an opaque application-facing value",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["protocol/go"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "opaque_connector",
      "layer": "portable_core",
      "description": "Lease-consuming direct and tunnel connection without exposing carrier credentials",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["controller/go"] },
        "typescript": { "status": "supported", "test_ids": ["server/typescript-acceptor"] },
        "swift": { "status": "supported", "test_ids": ["connector/swift-v3"] },
        "rust": { "status": "supported", "test_ids": ["controller/rust"] }
      }
    },
    {
      "id": "secure_session",
      "layer": "portable_core",
      "description": "Authenticated v3 sessions, bounded streams, rekey, cancellation, and close",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["protocol/go"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "rpc_call_notify",
      "layer": "portable_core",
      "description": "Typed RPC calls, outbound notifications, and peer notification subscriptions over the reserved encrypted v3 stream kind",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["protocol/go"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "validated_stream_metadata",
      "layer": "portable_core",
      "description": "Construction-validated application stream metadata used by both outgoing and incoming streams",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["carrier/go-direct"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "application_stream_handlers",
      "layer": "portable_core",
      "description": "Carrier-neutral bounded application-stream registration and dispatch for any established Session, with unknown-kind rejection, isolated handler failures, and shutdown completion",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["protocol/go"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "connection_controller",
      "layer": "portable_core",
      "description": "Single-owner long-lived connection lifecycle with fresh artifacts, structured retry, cancellation, and session replacement",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["controller/go"] },
        "typescript": { "status": "supported", "test_ids": ["controller/typescript"] },
        "swift": { "status": "supported", "test_ids": ["controller/swift"] },
        "rust": { "status": "supported", "test_ids": ["controller/rust"] }
      }
    },
    {
      "id": "negotiated_unreliable_messages",
      "layer": "portable_core",
      "description": "Negotiated carrier-neutral unreliable-message channels with portable error codes and accepted or dropped send outcomes",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["carrier/go-direct"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "unsupported", "reason": "The Apple client SDK does not expose an unreliable-message channel." },
        "rust": { "status": "supported", "test_ids": ["interop/rust-go/raw-quic/direct"] }
      }
    },
    {
      "id": "client_rpc_handlers",
      "layer": "portable_core",
      "description": "Reusable inbound RPC and notification definitions for one-shot and controller-managed endpoint-client sessions, with a fresh router for every connection generation",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "NewRPCHandlers/ConnectorOptions.RPCHandlers", "test_ids": ["controller/go-websocket-handlers"] },
        "typescript": { "status": "supported", "entrypoint": "@floegence/flowersec-core/node RPCHandlers/SessionOptions.rpcHandlers/ConnectionControllerOptions.rpcHandlers", "test_ids": ["controller/typescript-rpc-handlers-v3"] },
        "swift": { "status": "unsupported", "reason": "The Apple client runtime does not expose inbound request serving." },
        "rust": { "status": "supported", "entrypoint": "flowersec::RpcHandlers/ConnectorOptions::with_rpc_handlers", "test_ids": ["interop/rust-go/raw-quic/direct"] }
      }
    },
    {
      "id": "server_acceptor_session",
      "layer": "server_integration",
      "description": "Carrier-neutral server admission establishes the same public Session contract without exposing carrier or wire state; each runtime profile declares its exact listener support.",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "flowersec.NewAcceptor/Acceptor.Handler/AcceptorOptions.ResolveHandlers/SessionHandlers", "test_ids": ["server/go-acceptor"] },
        "typescript": { "status": "supported", "entrypoint": "@floegence/flowersec-core/node createAcceptor/Acceptor.accept -> AcceptedSession", "test_ids": ["server/typescript-acceptor"] },
        "swift": { "status": "unsupported", "reason": "Apple application processes do not provide the deployable listener profile required by this boundary." },
        "rust": { "status": "supported", "entrypoint": "flowersec::Acceptor::accept/accept_with_handlers -> Session/AcceptedSession", "test_ids": ["server/rust-acceptor"] }
      }
    },
    {
      "id": "server_session_handlers",
      "layer": "server_integration",
      "description": "Accepted sessions bind inbound RPC and application stream handlers before encrypted session establishment, validate application stream kinds as 1 through 128 canonical UTF-8 bytes outside the reserved RPC kind, and reset then close only the stream whose handler fails while keeping one session lifecycle owner.",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "AcceptorOptions.ResolveHandlers/NewSessionHandlers/SessionHandlers.HandleRPC/SessionHandlers.HandleStream", "test_ids": ["server/go-acceptor"] },
        "typescript": { "status": "supported", "entrypoint": "createAcceptor/SessionHandlers.handleRPC/SessionHandlers.handleStream/AcceptedSession.serve", "test_ids": ["server/typescript-acceptor"] },
        "swift": { "status": "unsupported", "reason": "The Apple listener profile cannot own pre-establishment inbound handlers." },
        "rust": { "status": "supported", "entrypoint": "flowersec::Acceptor::accept_with_handlers/SessionHandlers/RpcHandler/StreamHandler/AcceptedSession::serve", "test_ids": ["server/rust-acceptor-handlers"] }
      }
    },
    {
      "id": "controlplane_issue_authorize",
      "layer": "control_plane",
      "description": "Go-owned v3 artifact issuance with structured TLS endpoints, durable authorization records, and runtime admission authorization.",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "flowersec-go/v3/controlplane", "test_ids": ["server/go-controlplane"] },
        "typescript": { "status": "unsupported", "reason": "The TypeScript v3 SDK consumes issued artifacts and does not provide an issuer API." },
        "swift": { "status": "unsupported", "reason": "Control-plane persistence and atomic authorization are outside the Apple client SDK profile." },
        "rust": { "status": "unsupported", "reason": "The Rust v3 SDK consumes issued artifacts and does not provide an issuer API." }
      }
    },
    {
      "id": "server_admission_paths",
      "layer": "server_integration",
      "description": "Direct server admission binds authorization and application handlers before Session establishment; opaque tunnel relay ownership is declared separately in server_parity_contract.",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "flowersec.NewAcceptor: WebSocket/raw QUIC/WebTransport direct", "test_ids": ["server/go-acceptor"] },
        "typescript": { "status": "supported", "entrypoint": "@floegence/flowersec-core/node createAcceptor: WebSocket and raw QUIC direct", "test_ids": ["server/typescript-acceptor"] },
        "swift": { "status": "unsupported", "reason": "Apple platforms do not provide the deployable listener profile used by Flowersec servers." },
        "rust": { "status": "supported", "entrypoint": "flowersec::Acceptor: WebSocket and raw QUIC direct", "test_ids": ["server/rust-acceptor"] }
      }
    },
    {
      "id": "browser_proxy_runtime",
      "layer": "server_integration",
      "description": "The TypeScript browser proxy runtime and each server ProxyServer share one bounded Session/ByteStream application protocol for HTTP and WebSocket forwarding.",
      "implementations": {
        "go": { "status": "unsupported", "reason": "The v3 transport release does not claim browser proxy interoperability." },
        "typescript": { "status": "unsupported", "reason": "The default v3 Node.js export does not expose ProxyServer." },
        "swift": { "status": "unsupported", "reason": "The browser Service Worker and MessagePort APIs do not exist on the Apple SDK profile." },
        "rust": { "status": "unsupported", "reason": "The v3 transport release does not claim browser proxy interoperability." }
      }
    },
    {
      "id": "compat/v2/loopback_plaintext_websocket_direct",
      "layer": "portable_core",
      "description": "Canonical artifact profile for restricted plaintext WebSocket direct candidates on exact loopback only; this entry records parsing semantics, not runtime carrier availability.",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "flowersec.ParseArtifactV2", "test_ids": ["compat/v2/protocol/go"] },
        "typescript": { "status": "supported", "entrypoint": "@floegence/flowersec-core/v2 parseArtifact", "test_ids": ["compat/v2/protocol/typescript"] },
        "swift": { "status": "supported", "entrypoint": "Flowersec v2 artifact parser", "test_ids": ["compat/v2/protocol/swift"] },
        "rust": { "status": "supported", "entrypoint": "flowersec v2 artifact parser", "test_ids": ["compat/v2/protocol/rust"] }
      }
    },
    {
      "id": "compat/v2/loopback_plaintext_websocket_direct_runtime",
      "layer": "server_integration",
      "description": "Runtime connection profile that permits plaintext only for the exact direct subprotocol when the underlying TCP local and remote addresses are both loopback; tunnel, non-loopback, missing-address, and wrong-subprotocol connections fail closed.",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "flowersec v2 connector and acceptor", "test_ids": ["compat/v2/carrier/go-loopback-plaintext-direct"] },
        "typescript": { "status": "supported", "entrypoint": "@floegence/flowersec-core/v2 WebSocket connector", "test_ids": ["compat/v2/carrier/typescript-loopback-plaintext-direct"] },
        "swift": { "status": "supported", "entrypoint": "Flowersec v2 Apple WebSocket connector", "test_ids": ["compat/v2/carrier/swift-loopback-plaintext-direct"] },
        "rust": { "status": "supported", "entrypoint": "flowersec v2 WebSocket connector and acceptor", "test_ids": ["compat/v2/carrier/rust-loopback-plaintext-direct"] }
      }
    },
    {
      "id": "carrier_contract",
      "layer": "portable_core",
      "description": "Carrier-neutral stream semantics with WSS, raw QUIC, and WebTransport capability reporting",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["carrier/go-direct"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "wire_security",
      "layer": "portable_core",
      "description": "Canonical v3 handshake, record protection, admission and TLS-policy binding, and Unicode validation",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["protocol/go"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "test_ids": ["protocol/rust"] }
      }
    }
  ],
