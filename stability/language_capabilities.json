      }
    },
    {
      "id": "security_negative_v2",
      "path": "testdata/transport_v2/security_negative_vectors.json",
      "consumers": {
        "go": ["protocol/go"],
        "typescript": ["protocol/typescript"],
        "swift": ["protocol/swift"],
        "rust": ["protocol/rust"]
      }
    }
  ]
}
