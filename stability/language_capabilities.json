{
  "version": 2,
  "languages": ["go", "typescript", "swift", "rust"],
  "capability_layers": ["portable_core", "server_integration", "control_plane", "sdk_profile", "language_convenience"],
  "deployment_profiles": {
    "version": 1,
    "application_wire": "shared_across_runtimes_and_carriers",
    "profiles": [
      {
        "id": "native-server-core",
        "claimed_runtimes": ["go", "rust", "node-typescript"],
        "transport_runtime_ids": ["go_native", "rust_native", "typescript_node"],
        "required_roles": ["endpoint-client", "direct-server", "tunnel-runtime"],
        "required_carriers": ["websocket", "raw-quic"],
        "required_paths": {
          "endpoint-client": ["direct", "tunnel"],
          "direct-server": ["direct"],
          "tunnel-runtime": ["tunnel"]
        },
        "required_capability_ids": ["opaque_artifact", "opaque_connector", "secure_session", "rpc_call_notify", "validated_stream_metadata", "connection_controller", "server_acceptor_session", "server_session_handlers", "controlplane_issue_authorize", "server_admission_paths", "browser_proxy_runtime", "carrier_contract", "wire_security"],
        "optional_carriers": ["webtransport"],
        "required_tuple_count": 18,
        "required_path_unit_count": 24
      },
      {
        "id": "browser-client",
        "claimed_runtimes": ["typescript-browser"],
        "transport_runtime_ids": ["typescript_browser"],
        "required_roles": ["endpoint-client"],
        "required_carriers": ["websocket"],
        "required_paths": { "endpoint-client": ["direct", "tunnel"] },
        "required_capability_ids": ["opaque_artifact", "secure_session", "rpc_call_notify", "validated_stream_metadata", "connection_controller"],
        "optional_carriers": ["webtransport"],
        "required_tuple_count": 1,
        "required_path_unit_count": 2
      },
      {
        "id": "apple-client",
        "claimed_runtimes": ["swift"],
        "transport_runtime_ids": ["swift_ios", "swift_macos"],
        "required_roles": ["endpoint-client"],
        "required_carriers": ["websocket"],
        "required_paths": { "endpoint-client": ["direct", "tunnel"] },
        "required_capability_ids": ["opaque_artifact", "secure_session", "rpc_call_notify", "validated_stream_metadata", "connection_controller"],
        "optional_carriers": [],
        "required_tuple_count": 1,
        "required_path_unit_count": 2
      },
      {
        "id": "webtransport-server",
        "claimed_runtimes": [],
        "transport_runtime_ids": [],
        "required_roles": ["direct-server", "tunnel-runtime"],
        "required_carriers": ["webtransport"],
        "required_paths": {
          "direct-server": ["direct"],
          "tunnel-runtime": ["tunnel"]
        },
        "required_capability_ids": ["secure_session", "rpc_call_notify", "validated_stream_metadata", "carrier_contract", "wire_security"],
        "optional_carriers": [],
        "required_tuple_count": 0,
        "required_path_unit_count": 0
      }
    ]
  },
  "portable_capabilities": [
    {
      "id": "opaque_artifact",
      "layer": "portable_core",
      "description": "Strict Flowersec v2 artifact parsing behind an opaque application-facing value",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["protocol/go"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "opaque_connector",
      "layer": "portable_core",
      "description": "Lease-consuming direct and tunnel connection without exposing carrier credentials",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["controller/go"] },
        "typescript": { "status": "supported", "test_ids": ["controller/typescript-real-network-restart"] },
        "swift": { "status": "supported", "test_ids": ["controller/swift-real-network-restart"] },
        "rust": { "status": "supported", "test_ids": ["controller/rust"] }
      }
    },
    {
      "id": "secure_session",
      "layer": "portable_core",
      "description": "Authenticated v2 sessions, bounded streams, rekey, cancellation, and close",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["protocol/go"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "rpc_call_notify",
      "layer": "portable_core",
      "description": "Outbound RPC calls and notifications over the reserved encrypted v2 stream kind",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["protocol/go"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "validated_stream_metadata",
      "layer": "portable_core",
      "description": "Construction-validated application stream metadata used by both outgoing and incoming streams",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["carrier/go-direct"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "connection_controller",
      "layer": "portable_core",
      "description": "Single-owner long-lived connection lifecycle with fresh artifacts, structured retry, cancellation, and session replacement",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["controller/go"] },
        "typescript": { "status": "supported", "test_ids": ["controller/typescript"] },
        "swift": { "status": "supported", "test_ids": ["controller/swift"] },
        "rust": { "status": "supported", "test_ids": ["controller/rust"] }
      }
    },
    {
      "id": "server_acceptor_session",
      "layer": "server_integration",
      "description": "Carrier-neutral server admission establishes the same public Session contract without exposing carrier or wire state; each runtime profile declares its exact listener support.",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "flowersec.NewAcceptor/Acceptor.Handler/AcceptorOptions.ResolveHandlers/SessionHandlers", "test_ids": ["server/go-acceptor"] },
        "typescript": { "status": "supported", "entrypoint": "@floegence/flowersec-core/node createAcceptor/Acceptor.accept -> AcceptedSession", "test_ids": ["server/typescript-acceptor"] },
        "swift": { "status": "unsupported", "reason": "Apple application processes do not provide the deployable listener profile required by this boundary." },
        "rust": { "status": "supported", "entrypoint": "flowersec::Acceptor::accept/accept_with_handlers -> Session/AcceptedSession", "test_ids": ["server/rust-acceptor"] }
      }
    },
    {
      "id": "server_session_handlers",
      "layer": "server_integration",
      "description": "Accepted sessions bind inbound RPC and application stream handlers before encrypted session establishment, validate application stream kinds as 1 through 255 UTF-8 bytes outside the reserved RPC kind, and reset then close only the stream whose handler fails while keeping one session lifecycle owner.",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "AcceptorOptions.ResolveHandlers/NewSessionHandlers/SessionHandlers.HandleRPC/SessionHandlers.HandleStream", "test_ids": ["server/go-acceptor"] },
        "typescript": { "status": "supported", "entrypoint": "createAcceptor/SessionHandlers.handleRPC/SessionHandlers.handleStream/AcceptedSession.serve", "test_ids": ["server/typescript-acceptor"] },
        "swift": { "status": "unsupported", "reason": "The Apple listener profile cannot own pre-establishment inbound handlers." },
        "rust": { "status": "supported", "entrypoint": "flowersec::Acceptor::accept_with_handlers/SessionHandlers/RpcHandler/StreamHandler/AcceptedSession::serve", "test_ids": ["server/rust-acceptor-handlers"] }
      }
    },
    {
      "id": "controlplane_issue_authorize",
      "layer": "control_plane",
      "description": "Opaque artifact issuance, durable authorization records, and runtime admission authorization.",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "flowersec-go/v2/controlplane", "test_ids": ["server/go-controlplane"] },
        "typescript": { "status": "supported", "entrypoint": "@floegence/flowersec-core/node Issuer/AuthorizationRecord/RuntimeAuthorizationRequest/authorizeRuntime/authorizeTunnelRuntime", "test_ids": ["server/typescript-controlplane"] },
        "swift": { "status": "unsupported", "reason": "Control-plane persistence and atomic authorization are outside the Apple client SDK profile." },
        "rust": { "status": "supported", "entrypoint": "flowersec::controlplane::Issuer/AuthorizationRecord/RuntimeAuthorizationRequest::authorize/authorize_tunnel", "test_ids": ["server/rust-controlplane"] }
      }
    },
    {
      "id": "server_admission_paths",
      "layer": "server_integration",
      "description": "Direct server admission binds authorization and application handlers before Session establishment; opaque tunnel relay ownership is declared separately in server_parity_contract.",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "flowersec.NewAcceptor: WebSocket/raw QUIC/WebTransport direct", "test_ids": ["server/go-acceptor"] },
        "typescript": { "status": "supported", "entrypoint": "@floegence/flowersec-core/node createAcceptor: WebSocket and raw QUIC direct", "test_ids": ["server/typescript-acceptor"] },
        "swift": { "status": "unsupported", "reason": "Apple platforms do not provide the deployable listener profile used by Flowersec servers." },
        "rust": { "status": "supported", "entrypoint": "flowersec::Acceptor: WebSocket and raw QUIC direct", "test_ids": ["server/rust-acceptor"] }
      }
    },
    {
      "id": "browser_proxy_runtime",
      "layer": "server_integration",
      "description": "The TypeScript browser proxy runtime and each server ProxyServer share one bounded Session/ByteStream application protocol for HTTP and WebSocket forwarding.",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "flowersec.NewProxyServer/ProxyServer.Register(SessionHandlers)", "test_ids": ["interop/browser-proxy/server-matrix"] },
        "typescript": { "status": "supported", "entrypoint": "@floegence/flowersec-core/node ProxyServer/ProxyServerOptions and @floegence/flowersec-core/proxy createProxyRuntime", "test_ids": ["interop/browser-proxy/server-matrix"] },
        "swift": { "status": "unsupported", "reason": "The browser Service Worker and MessagePort APIs do not exist on the Apple SDK profile." },
        "rust": { "status": "supported", "entrypoint": "flowersec::ProxyServer/ProxyServerOptions/SessionHandlers", "test_ids": ["interop/browser-proxy/server-matrix"] }
      }
    },
    {
      "id": "loopback_plaintext_websocket_direct",
      "layer": "portable_core",
      "description": "Canonical artifact profile for restricted plaintext WebSocket direct candidates on exact loopback only; this entry records parsing semantics, not runtime carrier availability.",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "flowersec.ParseArtifact", "test_ids": ["protocol/go"] },
        "typescript": { "status": "supported", "entrypoint": "@floegence/flowersec-core parseArtifact", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "entrypoint": "Flowersec Artifact parser", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "entrypoint": "flowersec artifact parser", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "loopback_plaintext_websocket_direct_runtime",
      "layer": "server_integration",
      "description": "Runtime connection profile that permits plaintext only for the exact direct subprotocol when the underlying TCP local and remote addresses are both loopback; tunnel, non-loopback, missing-address, and wrong-subprotocol connections fail closed.",
      "implementations": {
        "go": { "status": "supported", "entrypoint": "flowersec.Connect and flowersec.Acceptor.Handler", "test_ids": ["carrier/go-loopback-plaintext-direct"] },
        "typescript": { "status": "supported", "entrypoint": "@floegence/flowersec-core/node connect and browser WebSocket connector", "test_ids": ["carrier/typescript-loopback-plaintext-direct"] },
        "swift": { "status": "supported", "entrypoint": "Flowersec Apple WebSocket connector", "test_ids": ["carrier/swift-loopback-plaintext-direct"] },
        "rust": { "status": "supported", "entrypoint": "flowersec::connect/Acceptor::bind_websocket", "test_ids": ["carrier/rust-websocket-direct"] }
      }
    },
    {
      "id": "carrier_contract",
      "layer": "portable_core",
      "description": "Carrier-neutral stream semantics with WSS, raw QUIC, and WebTransport capability reporting",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["carrier/go-direct"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "test_ids": ["protocol/rust"] }
      }
    },
    {
      "id": "wire_security",
      "layer": "portable_core",
      "description": "Canonical v2 handshake, record protection, admission binding, and Unicode validation",
      "implementations": {
        "go": { "status": "supported", "test_ids": ["protocol/go"] },
        "typescript": { "status": "supported", "test_ids": ["protocol/typescript"] },
        "swift": { "status": "supported", "test_ids": ["protocol/swift"] },
        "rust": { "status": "supported", "test_ids": ["protocol/rust"] }
      }
    }
  ],
