        "typescript": ["protocol/typescript"],
        "swift": ["protocol/swift"],
        "rust": ["protocol/rust"]
      }
    },
    {
      "id": "open_unicode_v2",
      "path": "testdata/transport_v2/open_unicode_vectors.json",
      "consumers": {
        "go": ["protocol/go"],
        "typescript": ["protocol/typescript"],
        "swift": ["protocol/swift"],
        "rust": ["protocol/rust"]
      }
    },
    {
      "id": "connection_controller",
      "path": "testdata/transport_v2/connection_controller_vectors.json",
      "consumers": {
        "go": ["controller/go"],
        "typescript": ["controller/typescript"],
        "swift": ["controller/swift"],
        "rust": ["controller/rust"]
      }
    },
    {
      "id": "session_wire_v2",
      "path": "testdata/transport_v2/session_wire_vectors.json",
      "consumers": {
        "go": ["protocol/go"],
