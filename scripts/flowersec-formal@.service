[Unit]
Description=Flowersec formal evidence collector %i
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
RuntimeMaxSec=12h
TimeoutStopSec=30s
KillMode=control-group
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/libexec/flowersec-transport-v2-runner-agent --role guest-root run-formal-root /etc/flowersec/transport-v2-runner.json /run/flowersec/transport-v2-runner-request.json flowersec-remote-runner-v1
