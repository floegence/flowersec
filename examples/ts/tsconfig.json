{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@floegence/flowersec-core/node": ["../../flowersec-ts/src/node/index.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "typeRoots": ["../../flowersec-ts/node_modules/@types"]
  },
  "include": ["node-client.mjs", "../../flowersec-ts/src/**/*.d.ts"]
}
