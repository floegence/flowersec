(set-logic QF_BV)
(define-sort Seq () (_ BitVec 64))
(define-sort Mask () (_ BitVec WIDTH))
(declare-const high Seq)
(declare-const bitmap Mask)
(declare-const incoming Seq)
(declare-const probe Seq)
(define-fun flag ((distance Seq)) Mask (bvshl (_ bv1 WIDTH) ((_ zero_extend EXTRA) distance)))
(define-fun stale ((top Seq) (number Seq)) Bool
  (and (bvule number top) (bvuge (bvsub top number) (_ bvWIDTH 64))))
(define-fun blocked ((top Seq) (bits Mask) (number Seq)) Bool
  (and (bvule number top)
       (or (stale top number) (distinct (bvand bits (flag (bvsub top number))) (_ bv0 WIDTH)))))
(define-fun ahead () Bool (bvugt incoming high))
(define-fun newHigh () Seq (ite ahead incoming high))
(define-fun newBits () Mask
  (ite ahead (bvor (_ bv1 WIDTH) (bvshl bitmap ((_ zero_extend EXTRA) (bvsub incoming high))))
             (bvor bitmap (flag (bvsub high incoming)))))
(assert (not (blocked high bitmap incoming)))
(push)
(echo "first_delivery_blocks_replay")
(assert (not (blocked incoming (_ bv1 WIDTH) incoming)))
(check-sat)
(pop)
(push)
(echo "exact_acceptance_update")
(assert (distinct (blocked newHigh newBits probe)
                  (or (blocked high bitmap probe) (= probe incoming) (stale newHigh probe))))
(check-sat)
(pop)
(push)
(echo "forward_jump_reachable")
(assert ahead)
(assert (bvuge (bvsub incoming high) (_ bvWIDTH 64)))
(check-sat)
(pop)
(push)
(echo "forget_history_control")
(assert ahead)
(assert (blocked high bitmap probe))
(assert (not (blocked newHigh (_ bv1 WIDTH) probe)))
(check-sat)
(pop)
