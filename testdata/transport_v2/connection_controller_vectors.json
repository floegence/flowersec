{
  "version": 1,
  "states": ["idle", "connecting", "connected", "waiting", "failed", "closed"],
  "retry_dispositions": ["terminal", "retryable", "retry_after"],
  "defaults": {
    "initial_delay_ms": 250,
    "max_delay_ms": 30000,
    "factor": 2,
    "jitter_ratio": 0,
    "attempt_limit": null
  },
  "backoff_vectors": [
    { "consecutive_failure": 1, "delay_ms": 250 },
    { "consecutive_failure": 2, "delay_ms": 500 },
    { "consecutive_failure": 3, "delay_ms": 1000 },
    { "consecutive_failure": 8, "delay_ms": 30000 },
    { "consecutive_failure": 20, "delay_ms": 30000 }
  ],
  "scenarios": [
    {
      "name": "connect_and_replace_after_termination",
      "events": ["start", "acquire:artifact-1", "connect:session-1", "terminate:retryable", "timer", "acquire:artifact-2", "connect:session-2"],
      "states": ["idle", "connecting", "connected", "waiting", "connecting", "connected"],
      "sessions": ["session-1", "session-2"],
      "replay": []
    },
    {
      "name": "retry_now_wakes_existing_wait",
      "events": ["start", "acquire:error:retryable", "retry_now", "acquire:artifact-1", "connect:session-1"],
      "states": ["idle", "connecting", "waiting", "connecting", "connected"],
      "scheduler_count": 1,
      "max_in_flight_attempts": 1
    },
    {
      "name": "retry_after_is_authoritative",
      "clock_start_unix_ms": 1000000,
      "events": ["start", "acquire:error:retry_after:1004000", "timer:1004000", "acquire:artifact-1", "connect:session-1"],
      "states": ["idle", "connecting", "waiting", "connecting", "connected"],
      "retry_at_unix_ms": 1004000
    },
    {
      "name": "terminal_failure",
      "events": ["start", "acquire:error:terminal"],
      "states": ["idle", "connecting", "failed"],
      "artifact_acquisitions": 1
    },
    {
      "name": "explicit_attempt_exhaustion",
      "policy": { "max_attempts": 2 },
      "events": ["start", "acquire:error:retryable", "timer", "acquire:error:retryable"],
      "states": ["idle", "connecting", "waiting", "connecting", "failed"],
      "artifact_acquisitions": 2
    },
    {
      "name": "close_cancels_single_attempt",
      "events": ["start", "acquire:pending", "close"],
      "states": ["idle", "connecting", "closed"],
      "max_in_flight_attempts": 1
    }
  ],
  "invariants": {
    "one_shot_artifact_controller": "forbidden",
    "fresh_artifact_per_attempt": true,
    "single_scheduler": true,
    "single_in_flight_attempt": true,
    "retry_now_outside_waiting": false,
    "old_stream_migration": false,
    "rpc_replay": false,
    "write_replay": false,
    "cross_session_exactly_once": false
  }
}
