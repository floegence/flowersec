FROM public.ecr.aws/docker/library/golang@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651 AS go_toolchain
FROM public.ecr.aws/docker/library/node@sha256:80fc934952c8f1b2b4d39907af7211f8a9fff1a4c2cf673fb49099292c251cec AS node_toolchain
# rust_toolchain: rustc 1.88.0, cargo 1.88.0
FROM public.ecr.aws/docker/library/rust@sha256:af306cfa71d987911a781c37b59d7d67d934f49684058f96cf72079c3626bfe0 AS rust_toolchain

FROM public.ecr.aws/ubuntu/ubuntu@sha256:22a8228e1e48cbe7e0e0f2056e752ffb8a35950cda150a4e5e16417200bec648

ENV DEBIAN_FRONTEND=noninteractive

ARG FLOWERSEC_RELEASE_APT_PACKAGES="\
    build-essential \
    clang \
    conntrack \
    curl \
    ethtool \
    git \
    iproute2 \
    iptables \
    jq \
    libasound2t64 \
    libatk-bridge2.0-0t64 \
    libatk1.0-0t64 \
    libatspi2.0-0t64 \
    libbpf-dev \
    libcap2-bin \
    libcairo2 \
    libcups2t64 \
    libdbus-1-3 \
    libdrm2 \
    libfontconfig1 \
    libfreetype6 \
    libgbm1 \
    libglib2.0-0t64 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libssl-dev \
    libx11-6 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    linux-tools-common \
    llvm \
    lsof \
    make \
    nftables \
    openssl \
    pkg-config \
    procps \
    python3 \
    socat \
    tcpdump \
    time \
    unzip \
    util-linux \
    xz-utils \
    xvfb \
    fonts-freefont-ttf \
    fonts-ipafont-gothic \
    fonts-liberation \
    fonts-noto-color-emoji \
    fonts-tlwg-loma-otf \
    fonts-unifont \
    fonts-wqy-zenhei \
    xfonts-cyrillic \
    xfonts-scalable"

RUN --mount=type=cache,id=flowersec-release-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=flowersec-release-apt-archives,target=/var/cache/apt/archives,sharing=locked \
    sed -i \
        -e 's|http://ports.ubuntu.com/ubuntu-ports/|http://mirrors.aliyun.com/ubuntu-ports/|g' \
        -e 's|http://archive.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g' \
        -e 's|http://security.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g' \
        /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=10 update \
    && apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=10 install --yes --no-install-recommends ca-certificates \
    && sed -i \
        -e 's|http://mirrors.aliyun.com/ubuntu-ports/|https://mirrors.aliyun.com/ubuntu-ports/|g' \
        -e 's|http://mirrors.aliyun.com/ubuntu/|https://mirrors.aliyun.com/ubuntu/|g' \
        /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=10 update

RUN --mount=type=cache,id=flowersec-release-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=flowersec-release-apt-archives,target=/var/cache/apt/archives,sharing=locked \
    apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=10 install \
        --yes --no-install-recommends --download-only \
        ${FLOWERSEC_RELEASE_APT_PACKAGES}

RUN --mount=type=cache,id=flowersec-release-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=flowersec-release-apt-archives,target=/var/cache/apt/archives,sharing=locked \
    apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=10 install \
        --yes --no-install-recommends --no-download \
        ${FLOWERSEC_RELEASE_APT_PACKAGES} \
    && rm -rf /var/lib/apt/lists/*

COPY --from=go_toolchain /usr/local/go /usr/local/go
COPY --from=node_toolchain /usr/local/bin/node /usr/local/bin/node
COPY --from=node_toolchain /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=rust_toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust_toolchain /usr/local/rustup /usr/local/rustup

RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ENV PATH=/usr/local/go/bin:/usr/local/cargo/bin:${PATH}
ENV CARGO_HOME=/cache/cargo
ENV GOCACHE=/cache/go-build
ENV GOMODCACHE=/cache/go-mod
ENV GOPROXY=https://goproxy.cn,direct
ENV npm_config_cache=/cache/npm
ENV PLAYWRIGHT_BROWSERS_PATH=/cache/playwright
ENV RUSTUP_HOME=/usr/local/rustup

WORKDIR /workspace/flowersec

CMD ["sleep", "infinity"]
